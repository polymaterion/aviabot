# Telegram
BOT_TOKEN=

# Travelpayouts
TRAVELPOUTS_TOKEN=
TRAVELPOUTS_MARKER=
TRAVELPOUTS_BASE_URL=https://api.travelpayouts.com
TRAVELPOUTS_AFFILIATE_BASE_URL=https://www.aviasales.com

# Database (docker-compose service name "postgres")
DATABASE_URL=postgresql+asyncpg://aviastan:aviastan@postgres:5432/aviastan

# Monitoring / caching
MONITORING_INTERVAL_MINUTES=15
SEARCH_CACHE_TTL=900
SEARCH_HISTORY_LIMIT=20
# Порог уведомления о снижении цены - отдельно для каждой валюты
# (300 рублей это не то же самое, что 300 долларов)
PRICE_DROP_NOTIFICATION_THRESHOLDS=RUB:300,USD:5,EUR:5
PRICE_DROP_NOTIFICATION_DEFAULT_THRESHOLD=5

# HTTP client
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF_SECONDS=1.5

# Misc
DEFAULT_LANGUAGE=ru
DEFAULT_CURRENCY=USD
LOG_LEVEL=INFO
# Telegram ID через запятую - у кого есть доступ к /users и /new_users.
# Узнать свой id можно у @userinfobot в Telegram.
ADMIN_TELEGRAM_IDS=
